<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 460" width="720" height="460" role="img">
  <style>
    text { font-family: "Liberation Sans", "DejaVu Sans", "Nimbus Sans L", Helvetica, Arial, sans-serif; }
    .title { font-size: 16px; font-weight: 700; fill: #1A1A1A; }
    .subtitle { font-size: 11px; fill: #5C5C5C; }
    .axis-label { font-size: 12px; font-weight: 600; fill: #333333; }
    .tick-label { font-size: 11px; fill: #333333; }
    .legend-text { font-size: 11px; fill: #333333; }
    .caption { font-size: 10px; fill: #5C5C5C; }
    .stat-value { font-size: 20px; font-weight: 700; fill: #1A1A1A; }
    .stat-label { font-size: 10px; font-weight: 600; fill: #5C5C5C; letter-spacing: 0.04em; }
    .interpretation { font-size: 11px; fill: #333333; }
    .grid { stroke: #E4E6EA; stroke-width: 1; }
    .axis { stroke: #333333; stroke-width: 1.2; }
    .reference-line { stroke: #D55E00; stroke-width: 1.2; stroke-dasharray: 5,3; }
    .reference-label { font-size: 10px; font-weight: 600; fill: #D55E00; }
    .bar-label { font-size: 11px; font-weight: 600; fill: #1A1A1A; }
    .on-bar { font-size: 11px; font-weight: 600; fill: #FFFFFF; }
  </style>
  <rect x="0.00" y="0.00" width="720.00" height="460.00" fill="#FFFFFF" stroke="none" stroke-width="0.0"/>
  <text x="360.00" y="22.00" text-anchor="middle" dominant-baseline="middle" class="title">Time-to-Chain Statistics</text>
  <text x="360.00" y="38.00" text-anchor="middle" dominant-baseline="middle" class="subtitle">Wall-clock time from run start to the first fully validated chain</text>
  <rect x="76.00" y="72.00" width="608.00" height="320.00" fill="#FBFCFD" stroke="#D7DCE2" stroke-width="1.0"/>
  <text x="16.00" y="232.00" text-anchor="middle" dominant-baseline="middle" transform="rotate(-90.0 16.00 232.00)" class="axis-label">Seconds</text>
  <text x="360.00" y="430.00" text-anchor="middle" dominant-baseline="middle" class="axis-label">Statistic</text>
  <text x="360.00" y="448.00" text-anchor="middle" dominant-baseline="middle" class="caption">N = 5 runs with a validated chain</text>
  <line x1="76.00" y1="392.00" x2="684.00" y2="392.00" stroke="#E4E6EA" stroke-width="1.0" stroke-linecap="square"/>
  <text x="68.00" y="392.00" text-anchor="end" dominant-baseline="middle" class="tick-label">0.00</text>
  <line x1="76.00" y1="312.00" x2="684.00" y2="312.00" stroke="#E4E6EA" stroke-width="1.0" stroke-linecap="square"/>
  <text x="68.00" y="312.00" text-anchor="end" dominant-baseline="middle" class="tick-label">0.37</text>
  <line x1="76.00" y1="232.00" x2="684.00" y2="232.00" stroke="#E4E6EA" stroke-width="1.0" stroke-linecap="square"/>
  <text x="68.00" y="232.00" text-anchor="end" dominant-baseline="middle" class="tick-label">0.75</text>
  <line x1="76.00" y1="152.00" x2="684.00" y2="152.00" stroke="#E4E6EA" stroke-width="1.0" stroke-linecap="square"/>
  <text x="68.00" y="152.00" text-anchor="end" dominant-baseline="middle" class="tick-label">1.12</text>
  <line x1="76.00" y1="72.00" x2="684.00" y2="72.00" stroke="#E4E6EA" stroke-width="1.0" stroke-linecap="square"/>
  <text x="68.00" y="72.00" text-anchor="end" dominant-baseline="middle" class="tick-label">1.50</text>
  <line x1="76.00" y1="72.00" x2="76.00" y2="392.00" stroke="#333333" stroke-width="1.2" stroke-linecap="square"/>
  <line x1="76.00" y1="392.00" x2="684.00" y2="392.00" stroke="#333333" stroke-width="1.2" stroke-linecap="square"/>
  <rect x="196.08" y="148.93" width="63.84" height="243.07" rx="3.00" fill="#0072B2" stroke="none" stroke-width="0.0"/>
  <text x="228.00" y="408.00" text-anchor="middle" dominant-baseline="middle" class="tick-label">Mean</text>
  <text x="228.00" y="136.93" text-anchor="middle" dominant-baseline="middle" class="bar-label">1.14s</text>
  <rect x="348.08" y="182.32" width="63.84" height="209.68" rx="3.00" fill="#009E73" stroke="none" stroke-width="0.0"/>
  <text x="380.00" y="408.00" text-anchor="middle" dominant-baseline="middle" class="tick-label">Min</text>
  <text x="380.00" y="170.32" text-anchor="middle" dominant-baseline="middle" class="bar-label">0.98s</text>
  <rect x="500.08" y="113.74" width="63.84" height="278.26" rx="3.00" fill="#CC79A7" stroke="none" stroke-width="0.0"/>
  <text x="532.00" y="408.00" text-anchor="middle" dominant-baseline="middle" class="tick-label">Max</text>
  <text x="532.00" y="101.74" text-anchor="middle" dominant-baseline="middle" class="bar-label">1.30s</text>
</svg>
